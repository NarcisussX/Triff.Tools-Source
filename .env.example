# TriffFits skill-profile SSO. These credentials are fitting-only.
EVE_SSO_CLIENT_ID=
EVE_SSO_CLIENT_SECRET=
EVE_SSO_CALLBACK_URL=
# Skillnix character-monitor SSO. Use a separate EVE developer application.
# Production callback: https://triff.tools/api/character-monitor/esi/callback
# Local Compose callback: http://localhost:3000/api/character-monitor/esi/callback
# Scopes are granted in the EVE developer app (not configured in .env):
# publicData, esi-skills.read_skills.v1, esi-skills.read_skillqueue.v1,
# esi-clones.read_implants.v1, esi-clones.read_clones.v1,
# esi-wallet.read_character_wallet.v1
SKILLNIX_EVE_SSO_CLIENT_ID=
SKILLNIX_EVE_SSO_CLIENT_SECRET=
SKILLNIX_EVE_SSO_CALLBACK_URL=
# In-game fitting import SSO. This is a third, separately scoped application.
EVE_FITTINGS_SSO_CLIENT_ID=
EVE_FITTINGS_SSO_CLIENT_SECRET=
EVE_FITTINGS_SSO_CALLBACK_URL=
# Shared server-side encryption key for stored ESI refresh tokens.
ESI_TOKEN_ENCRYPTION_KEY=
# /secret remains disabled unless password is 12+ chars and signing secret is 32+ chars.
SECRET_ADMIN_PASSWORD=
SECRET_ADMIN_SESSION_SECRET=
SECRET_ADMIN_SESSION_HOURS=8
# Optional exact origin override, e.g. https://triff.tools
SECRET_ADMIN_ALLOWED_ORIGIN=
STRUCTURE_CHECK_RATE_MAX=120
STRUCTURE_CHECK_RATE_WINDOW_MS=600000
# One-time initial saved-history timezone enrichment cap; set 0 to disable.
STRUCTURE_DEFENDER_BACKFILL_LIMIT=250
STRUCTURE_CORP_ACTIVITY_CACHE_MS=21600000
STRUCTURE_ZKILL_MIN_INTERVAL_MS=1100
